{
  "$schema": "https://opencode.ai/config.json",
  "tools": {"webfetch": false, "websearch": false, "codesearch": false},
  "agent": {
    "build": {"temperature": 0.6, "top_p": 0.95},
    "plan": {"temperature": 0.6, "top_p": 0.95},
    "general": {"temperature": 0.6, "top_p": 0.95},
    "explore": {"temperature": 0.6, "top_p": 0.95}
  },
  "provider": {
    "litellm": {
      "models": {
        "qwen3-4b": {
          "limit": {"context": 32768, "output": 8192},
          "options": {"top_k": 20, "min_p": 0.0, "chat_template_kwargs": {"enable_thinking": true}}
        }
      }
    }
  }
}
