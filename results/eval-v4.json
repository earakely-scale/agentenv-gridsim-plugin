  "framework": "agentenv",
  "tasks": {
    "split": "eval",
    "n": 30,
    "unit": "forecast windows",
    "packs": [
      "ercot-front-v4-eval"
    ],
    "labels": {
      "front": 21,
      "calm": 9
    },
    "sources": {
      "ercot": 30
    },
    "source": "ERCOT DAM/RT SPPs and DAM AS MCPCs; NOAA HRRR runs as issued; NWS VTEC; ERCOT notices; EIA-930 DF; desk forecasts and the price guide modelled from them",
    "selection": "the v4 filters (hindsight headroom, forecast value, anchor over idle) per kW",
    "flags": [
      "forecasts: desk (modelled from NOAA HRRR as issued)",
      "load_official: EIA-930 DF",
      "price_guide: modelled",
      "pv_availability: proxy",
      "reg_drift: seeded",
      "rt_as: n/a",
      "site: archetype"
    ]
  },
  "harness": {
    "agent": "gridsim-llm",
    "env": "gridsim-forecast",
    "tools": [
      "get_situation",
      "get_forecast",
      "get_forecast_drift",
      "check_schedule",
      "commit_schedule",
      "submit_dam",
      "advance",
      "get_time"
    ],
    "max_turns": {
      "front": 122,
      "front-lite": 72
    },
    "planning_calls_per_watch": 3,
    "forecast_calls_per_watch": 6,
    "dam_submits_per_gate": 3,
    "max_tokens": 16384,
    "effort": "high",
    "path": "A: every step ran through AgentEnv (gateway env, triggers with deploy payloads, virtual clock)"
  },
  "grading": {
    "scale": {
      "headline": "hindsight capture C = (P - P_idle)/(P_hind - P_idle), unclipped, the mean over tasks, beside the anchor's C and delta = C - C_anchor with its paired 95% CI",
      "second": "R on the anchor scale, a level and never differenced, with its R = 1 and beats-anchor shares",
      "comparisons": "(P - P_ref)/(P_hind - P_idle) with its paired 95% CI",
      "training": "S: R up to the anchor, then min(1.2, 1 + 0.2 (P - P_anchor)/(P_hind - P_anchor)); never on a board",
      "decision": "docs/REWARD-SCALES.md"
    },
    "hindsight": "P_hind: v3's hindsight MILP over the window",
    "reference": "the rolling MILP (HiGHS) played through the Session at every watch",
    "reward": "clip(0.2+0.8(P-P_idle)/(P_anchor-P_idle),0,1); no accepted hour in any submit_dam or commit_schedule scores 0",
    "idle": "no DAM, the battery idle, PV exported at RT",
    "anchor": {
      "front": "P_roll on the desk's P50 guide",
      "front-lite": "P_roll, battery only",
      "freeze-6h": "P_roll under the 6 h freeze",
      "blind": "P_blind on persistence"
    },
    "fields": {
      "capture": "C (replaces r_hind)",
      "anchor_capture": "the anchor's C",
      "delta": "C - C_anchor, paired (the verifier's paired_vs_anchor)",
      "mean": "R",
      "r_one": "share of runs at R = 1",
      "refs": "each reference's C and the paired gap"
    },
    "weight_0": [
      "audit",
      "r_hind",
      "paired_vs_anchor",
      "beats_anchor",
      "r_roll3",
      "forecast_value",
      "dam_missed",
      "baselines"
    ],
    "audit": "weight 0; a failed audit makes the run unscored",
    "excused": "AS shortfall or end-SoC shortfall from drift or deployments after the hour froze",
    "judge": false
  },
