{
  "env": "gridsim-forecast",
  "version": "v4",
  "forecast_version": "4.0",
  "contract_version": "1.0",
  "authors": [
    {
      "name": "Edgar Arakelyan",
      "github": "earakely-scale",
      "affiliation": "Scale AI"
    },
    {
      "name": "Adithya S Kolavi",
      "github": "adithya-s-k",
      "affiliation": "Hugging Face"
    }
