  "framework": "agentenv",
  "tasks": {
    "split": "eval",
    "n": 40,
    "unit": "hybrid site-days",
    "packs": [
      "ercot-hybrid-v3-eval"
    ],
    "as_strata": {
      "low": 14,
      "mid": 13,
      "high": 13
    },
    "source": "ERCOT DAM/RT SPPs and DAM AS MCPCs; NP4-745 solar (availability proxy); EIA-860 sites or archetypes",
    "selection": "low-spread, sponge-near-anchor and P_anchor - P_idle < $500 days dropped; Uri +-3 days out",
    "flags": [
      "deploy_frac: 1.0 assumed (stress case)",
      "poi: 1.2x",
      "poi: default",
      "pv_availability: proxy",
      "pv_scope: system",
      "pv_shape: ILR x fleet-AC cf (approximate)",
      "reg_drift: seeded",
      "site: archetype"
    ]
  },
  "harness": {
    "agent": "gridsim-llm",
    "env": "gridsim-hybrid",
    "tools": [
      "get_situation",
      "check_schedule",
      "commit_schedule",
      "advance",
      "get_time"
    ],
    "max_turns": 52,
    "planning_calls_per_watch": 3,
    "max_tokens": 16384,
    "effort": "high",
    "path": "A: every step ran through AgentEnv (gateway env, triggers with deploy payloads, virtual clock)"
  },
  "grading": {
    "scale": {
      "headline": "hindsight capture C = (P - P_idle)/(P_hind - P_idle), unclipped, the mean over tasks, beside the anchor's C and delta = C - C_anchor with its paired 95% CI",
      "second": "R on the anchor scale, a level and never differenced, with its R = 1 and beats-anchor shares",
      "comparisons": "(P - P_ref)/(P_hind - P_idle) with its paired 95% CI",
      "training": "S: R up to the anchor, then min(1.2, 1 + 0.2 (P - P_anchor)/(P_hind - P_anchor)); never on a board",
      "decision": "docs/REWARD-SCALES.md"
    },
    "hindsight": "P_hind: the hindsight MILP, a DA copy and a physical copy on realised RT, drift and deployments sharing the AS book",
    "reference": "information-matched rolling MILP (HiGHS) played through the Session",
    "reward": "clip(0.2+0.8(P-P_idle)/(P_anchor-P_idle),0,1); no accepted commit scores 0",
    "idle": "the solar-only plant",
    "anchor": "P_anchor: one MILP solve per watch on the day as known then, the same freeze, call budget and governor",
    "fields": {
      "capture": "C",
      "anchor_capture": "the anchor's C",
      "delta": "C - C_anchor, paired",
      "mean": "R",
      "r_one": "share of runs at R = 1",
      "refs": "each reference's C and the paired gap"
    },
    "weight_0": [
      "audit",
      "hindsight_capture",
      "energy_only",
      "as_share",
      "clip_recovered",
      "ftp"
    ],
    "audit": "weight 0; a failed audit makes the run unscored",
    "excused": "AS shortfall or end-SoC shortfall from drift or deployments after the hour froze",
    "judge": false
  },
