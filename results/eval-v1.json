  "framework": "agentenv",
  "tasks": {
    "split": [
      "eval_2025",
      "rtcb"
    ],
    "n": 750,
    "unit": "battery-hub-days",
    "packs": [
      "ercot-dam-v1-eval",
      "ercot-dam-v1-rtcb"
    ],
    "source": "ERCOT NP4-180-ER hub/LZ DAM SPPs; EIA-860 archetypes",
    "selection": "low-spread and greedy-easy filters; 2025 held out"
  },
  "harness": {
    "agent": "gridsim-llm",
    "tools": [
      "get_situation",
      "check_schedule",
      "submit_schedule"
    ],
    "max_turns": 4,
    "max_tokens": 4096,
    "effort": "high",
    "bundles": {
      "full": "3 checks",
      "oneshot": "submit_schedule only"
    }
  },
  "grading": {
    "scale": {
      "headline": "hindsight capture C = (P - P_idle)/(P_hind - P_idle), unclipped, the mean over tasks, beside the anchor's C and delta = C - C_anchor with its paired 95% CI",
      "second": "R on the anchor scale, a level and never differenced, with its R = 1 and beats-anchor shares",
      "comparisons": "(P - P_ref)/(P_hind - P_idle) with its paired 95% CI",
      "training": "S: R up to the anchor, then min(1.2, 1 + 0.2 (P - P_anchor)/(P_hind - P_anchor)); never on a board",
      "decision": "docs/REWARD-SCALES.md"
    },
    "reference": "exact DP over integer SoC (LP bound reported)",
    "hindsight": "P_opt (exact DP); at the foresight tier the anchor is the hindsight, so C = (R - 0.2)/0.8 and the tier reads as solved",
    "reward": "clip(0.2+0.8(P-P_idle)/(P_anchor-P_idle),0,1)",
    "anchor": {
      "foresight": "P_opt (exact DP)",
      "blind": "max(P_persist, P_ridge)"
    },
    "fields": {
      "capture": "C",
      "anchor_capture": "the anchor's C",
      "delta": "C - C_anchor, paired",
      "mean": "R",
      "r_one": "share of runs at R = 1",
      "refs": "each reference's C and the paired gap"
    },
    "optimal": "R >= 0.99",
    "ci": "95% bootstrap over tasks, 10,000 resamples",
    "excused": "none",
    "judge": false
  },
