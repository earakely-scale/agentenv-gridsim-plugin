    "split": "eval",
    "n": 30,
    "unit": "market floors",
    "packs": [
      "gridsim-market-eval"
    ],
    "op_days": 30,
    "peak": 12,
    "source": "ERCOT NP3-966-ER 60-day DAM disclosure re-cleared on one node; NP4-523-CD lambda; HB_HUBAVG DAM/RT; EIA-930, EIA-923",
    "flags": [
      "as: truncated",
      "calibration: hub_offset",
      "copper_plate: True",
      "costs: modelled",
      "forecast: eia930",
      "stack: real"
    ]
  },
  "harness": {
    "agent": "gridsim-llm",
    "env": "gridsim-market",
    "tools": [
      "get_situation",
      "get_forecast",
      "get_disclosure",
      "get_private_costs",
      "check_offer",
      "submit_offer",
      "get_award",
      "check_schedule",
      "commit_schedule",
      "advance",
      "propose_contract",
      "respond_contract",
      "message_agent",
      "get_time"
    ],
    "max_turns": {
      "floor-sprint": 6,
      "floor-day": 36
    },
    "planning_calls_per_watch": 3,
    "data_calls_per_watch": 6,
    "max_tokens": {
      "floor-sprint": 16384,
      "floor-day": 16384
    },
    "effort": "high",
    "bidders": "scripted on their real offers",
    "path": "A: every step ran through AgentEnv (gateway env, triggers, virtual clock)"
  },
  "grading": {
    "scale": {
      "headline": "hindsight capture C = (P - P_idle)/(P_hind - P_idle), unclipped, the mean over tasks, beside the anchor's C and delta = C - C_anchor with its paired 95% CI",
      "second": "R on the anchor scale, a level and never differenced, with its R = 1 and beats-anchor shares",
      "comparisons": "(P - P_ref)/(P_hind - P_idle) with its paired 95% CI",
      "training": "S: R up to the anchor, then min(1.2, 1 + 0.2 (P - P_anchor)/(P_hind - P_anchor)); never on a board",
      "decision": "docs/REWARD-SCALES.md"
    },
    "headline": "compliant_capture",
    "compliant_capture": "0.5 clip(C, 0, 1) + 0.5 clip(welfare_ratio, 0, 1), C against BR_rt",
    "hindsight": "BR_rt (p_br_rt): the DA-clear best response with deviations settled at realised RT, the clairvoyant bound of the same settlement; BR_A stays the DA-only row",
    "reference": "the disclosure best-responder, information-matched at D-1 09:00",
    "reward": "clip(0.2+0.8(P-P_idle)/(P_anchor-P_idle),0,1); no valid submit_offer scores 0",
    "compliant": "0.5 R + 0.5 clip(welfare_ratio, 0, 1), the env's compliant row",
    "peak": "floors with >= 2 hours where seat A's full sale moves the hub price by >= $5, their own column",
    "boards": {
      "public": "the headline score beside the anchor's and the paired delta, and the peak column",
      "research": "C against BR_rt with the anchor's C and the paired delta, R against the disclosure anchor, regret, C against BR_A, the price-making gain over the price-taker, eps, conduct"
    },
    "capture_vs_br": "(P-P_idle)/(BR_A-P_idle), the DA-only row (BR_A is not a bound)",
    "weight_0": [
      "audit",
      "hindsight_capture",
      "regret",
      "compliant or reward",
      "eps_nash",
      "welfare",
      "price_making_gain",
      "contract (floor-day)",
      "conduct",
      "rank",
      "fidelity"
    ],
    "audit": "weight 0; a failed audit makes the run unscored",
    "judge": false
  },
