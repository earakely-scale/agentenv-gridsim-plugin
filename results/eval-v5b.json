    "flags": [
      "as: truncated",
      "calibration: hub_offset",
      "copper_plate: True",
      "costs: modelled",
      "forecast: eia930",
      "stack: real"
    ]
  },
  "harness": {
    "agent": "gridsim-llm",
    "env": "gridsim-market",
    "tools": [
      "get_situation",
      "get_forecast",
      "get_disclosure",
      "get_private_costs",
      "check_offer",
      "submit_offer",
      "get_award",
      "check_schedule",
      "commit_schedule",
      "advance",
      "propose_contract",
      "respond_contract",
      "message_agent",
      "get_time"
    ],
    "max_turns": {
      "floor-sprint": 6,
      "floor-day": 36
    },
    "planning_calls_per_watch": 3,
    "data_calls_per_watch": 6,
    "max_tokens": {
      "floor-sprint": 16384,
      "floor-day": 16384
    },
    "effort": "high",
    "bidders": "scripted on their real offers",
    "path": "A: every step ran through AgentEnv (gateway env, triggers, virtual clock)"
  },
  "grading": {
    "headline": "compliant",
    "reference": "the disclosure best-responder, information-matched at D-1 09:00",
    "reward": "clip(0.2+0.8(P-P_idle)/(P_anchor-P_idle),0,1); no valid submit_offer scores 0",
    "compliant": "0.5 R + 0.5 clip(welfare_ratio, 0, 1)",
    "peak": "floors with >= 2 hours where seat A's full sale moves the hub price by >= $5, their own column",
    "boards": {
      "public": "the headline score and the peak column",
      "research": "R against the disclosure anchor, regret, hindsight capture, the price-making gain over the price-taker, eps, conduct"
    },
    "hindsight_capture": "(P-P_idle)/(BR_A-P_idle), BR_A the hindsight best response, a weight-0 row",
    "weight_0": [
      "audit",
      "hindsight_capture",
      "regret",
      "compliant or reward",
      "eps_nash",
      "welfare",
      "price_making_gain",
      "contract (floor-day)",
      "conduct",
      "rank",
      "fidelity"
    ],
    "audit": "weight 0; a failed audit makes the run unscored",
    "judge": false
  },
