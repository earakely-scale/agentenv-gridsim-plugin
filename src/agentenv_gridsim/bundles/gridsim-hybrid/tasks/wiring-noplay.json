[
  {
    "id": "deploy",
    "type": "deploy_env",
    "env_id": "gridsim-hybrid"
  },
  {
    "id": "load-task",
    "type": "apply_server_config",
    "env_id": "gridsim-hybrid",
    "directives": [
      {
        "service": "gridsim-hybrid",
        "uri": "urn:gridsim:live-load/v1",
        "args": {
          "task_id": "hyb-v3-2023-08-24-LZ_LCRA-pv150-b100x2h-poi107",
          "tier": "reserves"
        }
      }
    ]
  },
  {
    "id": "hide-grid-notice",
    "type": "modify_env_tool_access",
    "env_id": "gridsim-hybrid",
    "action": "disable",
    "role": "default",
    "tools": [
      "grid_notice"
    ]
  },
  {
    "id": "watches",
    "type": "register_env_triggers",
    "env_id": "gridsim-hybrid",
    "watch_roles": [
      "default"
    ],
    "triggers": [
      {
        "id": "watch-1",
        "when": {
          "type": "action",
          "tool": "advance",
          "where": {
            "result.watch": {
              "equals": 1
            }
          }
        },
        "barrier": {
          "at": "provoking_call",
          "timeout_seconds": 60
        },
        "actions": [
          {
            "type": "tool",
            "tool": "grid_notice",
            "args": {
              "event_id": "VTEC-FWD-EH.W-2023-0012-central",
              "name": "NWS FWD",
              "text": "NWS FWD: Excessive Heat Warning for McLennan until 2023-08-27 18:52 CPT.",
              "level": "Warning",
              "derate_mw": null,
              "from": null,
              "until": null
            }
          },
          {
            "type": "tool",
            "tool": "grid_notice",
            "args": {
              "event_id": "OPS-44ac2d5e198c",
              "name": "ERCOT",
              "text": "ERCOT issued a Watch (projected reserve capacity shortage with no market solution available for Thursday, August 24, 2023 HE...).",
              "level": "Watch",
              "derate_mw": null,
              "from": null,
              "until": null
            }
          }
        ]
      },
      {
        "id": "watch-2",
        "when": {
          "type": "action",
          "tool": "advance",
