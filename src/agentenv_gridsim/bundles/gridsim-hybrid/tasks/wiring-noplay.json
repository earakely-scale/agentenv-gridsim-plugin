[
  {
    "id": "deploy",
    "type": "deploy_env",
    "env_id": "gridsim-hybrid"
  },
  {
    "id": "load-task",
    "type": "apply_server_config",
    "env_id": "gridsim-hybrid",
    "directives": [
      {
        "service": "gridsim-hybrid",
        "uri": "urn:gridsim:live-load/v1",
        "args": {
          "task_id": "hyb-v3-2022-01-16-LZ_CPS-pv150-b100x2h-poi150",
          "tier": "reserves"
        }
      }
    ]
  },
  {
    "id": "hide-grid-notice",
    "type": "modify_env_tool_access",
    "env_id": "gridsim-hybrid",
    "action": "disable",
    "role": "default",
    "tools": [
      "grid_notice"
    ]
  },
  {
    "id": "watches",
    "type": "register_env_triggers",
    "env_id": "gridsim-hybrid",
    "watch_roles": [
      "default"
    ],
    "triggers": [
      {
        "id": "watch-1",
        "when": {
          "type": "action",
          "tool": "advance",
          "where": {
            "result.watch": {
              "equals": 1
            }
          }
        },
        "barrier": {
          "at": "provoking_call",
          "timeout_seconds": 60
        },
        "actions": []
      },
      {
        "id": "watch-2",
        "when": {
          "type": "action",
          "tool": "advance",
          "where": {
            "result.watch": {
              "equals": 2
            }
          }
        },
        "barrier": {
          "at": "provoking_call",
          "timeout_seconds": 60
        },
        "actions": []
      },
      {
        "id": "watch-3",
        "when": {
          "type": "action",
          "tool": "advance",
          "where": {
            "result.watch": {
              "equals": 3
            }
          }
        },
        "barrier": {
          "at": "provoking_call",
          "timeout_seconds": 60
        },
        "actions": []
      },
      {
        "id": "watch-4",
        "when": {
          "type": "action",
          "tool": "advance",
          "where": {
            "result.watch": {
              "equals": 4
            }
          }
        },
        "barrier": {
          "at": "provoking_call",
          "timeout_seconds": 60
        },
        "actions": []
      },
      {
        "id": "watch-5",
        "when": {
          "type": "action",
          "tool": "advance",
          "where": {
            "result.watch": {
              "equals": 5
            }
          }
        },
        "barrier": {
          "at": "provoking_call",
          "timeout_seconds": 60
        },
        "actions": [
          {
            "type": "tool",
            "tool": "grid_notice",
            "args": {
              "event_id": "dep-rrs-20220116T1903",
              "name": "ERCOT",
              "text": "ERCOT deployed RRS at 100% of awards from 19:03 to 19:10.",
              "level": null,
              "derate_mw": null,
              "from": null,
              "until": null,
              "deploy": {
                "product": "rrs",
                "frac": 1.0,
                "start_min": 1143,
                "end_min": 1150
              }
            }
          }
        ]
      }
    ]
  },
  {
    "id": "clock",
    "type": "sync_env_clock",
    "env_id": "gridsim-hybrid",
    "virtual_time": "2022-01-15T20:00:00Z",
    "virtual_seconds_per_real_second": 0,
    "tolerate_missing_sync_time": false
  },
  {
    "id": "end-day",
    "type": "apply_server_config",
    "env_id": "gridsim-hybrid",
    "directives": [
      {
        "service": "gridsim-hybrid",
        "uri": "urn:gridsim:end-day/v1",
        "args": {}
      }
    ]
  },
  {
    "id": "grade",
    "type": "env_outcome_verifier",
    "env_id": "gridsim-hybrid",
    "file_artifact_id": "gridsim-hybrid-verifier",
    "verifier_id": "gridsim",
    "score_aggregator": "weighted_average"
  }
]
